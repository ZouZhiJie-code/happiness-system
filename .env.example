# Local development defaults.
# For the hosted Vercel lane, copy `.env.preview.example` or `.env.production.example`
# and fill the real hosted values there before setting them in the platform UI.
DATABASE_URL="postgresql://zouzhijie@localhost:5432/happiness_system_codex?schema=public"
DIRECT_URL="postgresql://zouzhijie@localhost:5432/happiness_system_codex?schema=public"
AI_RUNTIME_CONFIG_SECRET=""
CRON_SECRET=""
AI_PROVIDER="openai" # DeepSeek 官方 API 走 OpenAI 兼容协议
INTERVIEW_INTENT_V2_MODE="enforce"
INTERVIEW_EVENT_CENTERED_MODE="legacy"
INTERVIEW_EVENT_CENTERED_STRATEGY="baseline"
EVENT_CENTERED_GENERATIVE_MODEL="deepseek-v4-flash" # event-centered candidate model; shared five-dimension chat keeps DEEPSEEK_MODEL
BOARD8_GI059_REVIEW_ENABLED="" # local isolated Preview only; set I_UNDERSTAND to open /preview/board8-gi059-review
DAILY_LIGHT_JOURNAL_PREVIEW_ENABLED="" # local fixed-six journal Preview only; set I_UNDERSTAND to enable the isolated adapter
INTERVIEW_REGENERATION_ENABLED="true"
# DeepSeek V4 Pro takes priority when these three values are set. It uses DeepSeek's OpenAI-compatible chat-completions API.
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-v4-pro"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
# Legacy Ark-compatible chat configuration is retained only as an explicit rollback option.
VOLCENGINE_ARK_API_KEY="" # optional: legacy rollback only; current chat uses DeepSeek official API
VOLCENGINE_ARK_MODEL="" # optional: legacy rollback only; current chat uses DeepSeek official API
VOLCENGINE_ARK_BASE_URL="https://ark.cn-beijing.volces.com/api/v3" # optional: legacy rollback only
# 事件中心离线评测：策略回放采用上方 DEEPSEEK_*；Judge 显式使用更高标准模型。
EVENT_CENTERED_JUDGE_DEEPSEEK_MODEL="deepseek-v4-pro"
EVENT_CENTERED_JUDGE_TIMEOUT_MS="20000"
# GI-088 阶段 C 千问 Judge：获得独立授权并完成 20 张卡校准前保持空值。
EVENT_CENTERED_JUDGE_QWEN_API_KEY=""
EVENT_CENTERED_JUDGE_QWEN_BASE_URL=""
EVENT_CENTERED_JUDGE_QWEN_MODEL=""
EVENT_CENTERED_JUDGE_QWEN_THINKING_MODE=""
# Embedding endpoint for vector memory (doubao-embedding model)
VOLCENGINE_ARK_EMBEDDING_ENDPOINT_ID="" # optional: legacy embedding path only
APP_URL="http://localhost:3000"
ADMIN_USERNAMES=""
ACCEPTANCE_ADMIN_USERNAME="acceptance_admin"
ACCEPTANCE_ADMIN_PASSWORD="Acceptance-Only-2026"
ACCEPTANCE_LOGIN_TOKEN="local-ai-quality-acceptance"
