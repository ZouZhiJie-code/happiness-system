<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="30.2.6">
  <diagram name="意图识别功能架构">
    <mxGraphModel dx="1500" dy="1320" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1320" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="2" value="访谈功能｜意图识别功能架构" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=28;fontStyle=1;fontColor=#4a3428;" vertex="1" parent="1">
          <mxGeometry x="70" y="20" width="800" height="45" as="geometry" />
        </mxCell>
        <mxCell id="3" value="核心职责：识别用户希望系统下一步做什么，并输出本轮访谈的控制信号。" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontColor=#6b574b;" vertex="1" parent="1">
          <mxGeometry x="70" y="70" width="820" height="35" as="geometry" />
        </mxCell>
        <mxCell id="4" value="范围说明｜显式按钮动作已携带确定指令，直接进入下游执行；本图聚焦自然语言 reply 的识别链路。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#555555;fontSize=12;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="950" y="50" width="480" height="50" as="geometry" />
        </mxCell>

        <mxCell id="10" value="① 输入上下文" style="swimlane;startSize=36;html=1;rounded=1;container=1;pointerEvents=0;fillColor=#f6f9fd;strokeColor=#6c8ebf;fontColor=#304b68;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="130" width="1360" height="160" as="geometry" />
        </mxCell>
        <mxCell id="11" value="用户自然语言回复&#xa;&lt;font style=&quot;font-size:12px;font-weight:normal;color:#61768b&quot;&gt;文字输入或语音转写内容&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#304b68;fontSize=16;fontStyle=1;spacing=10;" vertex="1" parent="10">
          <mxGeometry x="150" y="60" width="420" height="70" as="geometry" />
        </mxCell>
        <mxCell id="12" value="当前会话上下文&#xa;&lt;font style=&quot;font-size:12px;font-weight:normal;color:#61768b&quot;&gt;维度、事件、阶段、历史消息、待处理选择&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#304b68;fontSize=16;fontStyle=1;spacing=10;" vertex="1" parent="10">
          <mxGeometry x="790" y="60" width="420" height="70" as="geometry" />
        </mxCell>

        <mxCell id="20" value="② 意图识别核心" style="swimlane;startSize=36;html=1;rounded=1;container=1;pointerEvents=0;fillColor=#fffaf2;strokeColor=#d79b00;fontColor=#6b4300;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="320" width="1360" height="240" as="geometry" />
        </mxCell>
        <mxCell id="21" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;规则化意图路由器&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;table style=&quot;width:100%;font-size:13px;border-collapse:collapse&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:28%;padding-right:18px;vertical-align:top&quot;&gt;&lt;b&gt;A. 输入规范化&lt;/b&gt;&lt;br&gt;去空格、统一文本形式、确认 reply 输入&lt;/td&gt;&lt;td style=&quot;width:40%;padding:0 18px;border-left:1px solid #d79b00;border-right:1px solid #d79b00;vertical-align:top&quot;&gt;&lt;b&gt;B. 单标签优先级匹配&lt;/b&gt;&lt;br&gt;直接生成 → 停止边界 → 问题修复 → 否定推测 → 低信息 → 正常内容&lt;/td&gt;&lt;td style=&quot;width:32%;padding-left:18px;vertical-align:top&quot;&gt;&lt;b&gt;C. 输出意图标签&lt;/b&gt;&lt;br&gt;content / hypothesis_denial&lt;br&gt;question_repair / low_signal&lt;br&gt;draft_request / boundary_stop / hostile_boundary&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#6b4300;fontSize=14;spacing=16;align=left;verticalAlign=top;" vertex="1" parent="20">
          <mxGeometry x="180" y="60" width="1000" height="145" as="geometry" />
        </mxCell>

        <mxCell id="30" value="③ 控制信号输出" style="swimlane;startSize=36;html=1;rounded=1;container=1;pointerEvents=0;fillColor=#fbf8fd;strokeColor=#9673a6;fontColor=#5d3f68;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="590" width="1360" height="160" as="geometry" />
        </mxCell>
        <mxCell id="31" value="&lt;b style=&quot;font-size:16px&quot;&gt;Intent Assessment｜本轮控制契约&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;意图标签 intent　｜　是否有效 isMeaningful　｜　是否提取材料 shouldExtractSnapshot　｜　是否推进 turn / round　｜　问题修复方式 repairSignal&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#55375f;fontSize=14;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="30">
          <mxGeometry x="170" y="60" width="1020" height="70" as="geometry" />
        </mxCell>

        <mxCell id="40" value="④ 策略路由" style="swimlane;startSize=36;html=1;rounded=1;container=1;pointerEvents=0;fillColor=#fafafa;strokeColor=#888888;fontColor=#444444;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="780" width="1360" height="250" as="geometry" />
        </mxCell>
        <mxCell id="41" value="&lt;b style=&quot;font-size:16px&quot;&gt;内容新增 / 纠正&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;text-align:left;font-size:12px;margin-top:10px&quot;&gt;&lt;b&gt;content&lt;/b&gt;：提取新材料&lt;br&gt;&lt;b&gt;hypothesis_denial&lt;/b&gt;：修正错误推测&lt;br&gt;&lt;br&gt;提取材料：是　推进进度：是&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#355c32;fontSize=14;spacing=12;align=center;verticalAlign=top;" vertex="1" parent="40">
          <mxGeometry x="35" y="60" width="300" height="155" as="geometry" />
        </mxCell>
        <mxCell id="42" value="&lt;b style=&quot;font-size:16px&quot;&gt;问题修复&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;text-align:left;font-size:12px;margin-top:10px&quot;&gt;&lt;b&gt;question_repair&lt;/b&gt;&lt;br&gt;简化、改写或换成具体锚点&lt;br&gt;连续第 3 次进入低压选择&lt;br&gt;&lt;br&gt;提取材料：否　推进进度：否&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#5d3f68;fontSize=14;spacing=12;align=center;verticalAlign=top;" vertex="1" parent="40">
          <mxGeometry x="365" y="60" width="300" height="155" as="geometry" />
        </mxCell>
        <mxCell id="43" value="&lt;b style=&quot;font-size:16px&quot;&gt;生成 / 停止收束&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;text-align:left;font-size:12px;margin-top:10px&quot;&gt;&lt;b&gt;draft_request&lt;/b&gt;：已有回复 → 当前版本；空会话 → 先补材料&lt;br&gt;&lt;b&gt;boundary_stop / hostile_boundary&lt;/b&gt;：核心材料充分 → 当前版本；材料不足 → 低压选择&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7a3835;fontSize=14;spacing=12;align=center;verticalAlign=top;" vertex="1" parent="40">
          <mxGeometry x="695" y="60" width="300" height="155" as="geometry" />
        </mxCell>
        <mxCell id="44" value="&lt;b style=&quot;font-size:16px&quot;&gt;低信息保持&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;text-align:left;font-size:12px;margin-top:10px&quot;&gt;&lt;b&gt;low_signal&lt;/b&gt;&lt;br&gt;保留已有材料与当前阶段&lt;br&gt;继续当前阶段的低压引导&lt;br&gt;&lt;br&gt;提取材料：否　推进进度：否&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#4b4b4b;fontSize=14;spacing=12;align=center;verticalAlign=top;" vertex="1" parent="40">
          <mxGeometry x="1025" y="60" width="300" height="155" as="geometry" />
        </mxCell>

        <mxCell id="50" value="⑤ 下游执行与响应" style="swimlane;startSize=36;html=1;rounded=1;container=1;pointerEvents=0;fillColor=#f6fbf5;strokeColor=#82b366;fontColor=#355c32;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="1060" width="1360" height="180" as="geometry" />
        </mxCell>
        <mxCell id="51" value="&lt;b style=&quot;font-size:16px&quot;&gt;执行识别结果&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;按需进入槽位提取与访谈状态机　→　生成追问或选择卡　→　保存消息、控制信号和会话状态　→　向用户响应&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#355c32;fontSize=14;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="50">
          <mxGeometry x="170" y="70" width="1020" height="75" as="geometry" />
        </mxCell>

