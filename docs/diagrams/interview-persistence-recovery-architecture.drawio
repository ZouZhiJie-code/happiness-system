<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="30.2.6">
  <diagram id="node10-persistence-recovery" name="节点十">
    <mxGraphModel dx="2000" dy="1210" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1210" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="节点十｜状态落库与会话恢复" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=28;fontStyle=1;fontColor=#2F3A4A;" vertex="1" parent="1">
          <mxGeometry x="50" y="20" width="900" height="50" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="用户原话先形成可恢复事实，再完成 AI 处理，并按日期、维度和待处理回复恢复现场" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=15;fontColor=#667085;" vertex="1" parent="1">
          <mxGeometry x="50" y="70" width="1150" height="35" as="geometry" />
        </mxCell>

        <mxCell id="lane_write" value="① 从用户动作到持久化事务" style="swimlane;startSize=38;horizontal=1;rounded=1;arcSize=8;container=1;collapsible=0;pointerEvents=0;whiteSpace=wrap;html=1;fontFamily=PingFang SC;fontSize=16;fontStyle=1;fontColor=#26415E;fillColor=#F4F8FC;swimlaneFillColor=#FFFFFF;strokeColor=#9BB7D3;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="50" y="120" width="1900" height="230" as="geometry" />
        </mxCell>
        <mxCell id="action" value="&lt;b&gt;用户 / API 动作&lt;/b&gt;&#xa;回复・继续深挖・下一事件&#xa;页面保存输入草稿与待发 outbox" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontSize=14;spacing=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;" vertex="1" parent="lane_write">
          <mxGeometry x="50" y="70" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="reserve" value="&lt;b&gt;先接收并保留本轮&lt;/b&gt;&#xa;校验对话位置与重复提交&#xa;写 InterviewUserTurn + 用户原话" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontSize=14;spacing=8;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;" vertex="1" parent="lane_write">
          <mxGeometry x="500" y="70" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="prepare" value="&lt;b&gt;服务层形成下一状态&lt;/b&gt;&#xa;意图・槽位・问题・快照&#xa;阶段・轮数・progressData" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontSize=14;spacing=8;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.5;" vertex="1" parent="lane_write">
          <mxGeometry x="950" y="70" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="transaction" value="&lt;b&gt;完成事务&lt;/b&gt;&#xa;保存助手消息、快照、事件与会话&#xa;本轮状态更新为 completed" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontSize=14;spacing=8;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;" vertex="1" parent="lane_write">
          <mxGeometry x="1400" y="70" width="360" height="120" as="geometry" />
        </mxCell>

        <mxCell id="lane_facts" value="② 持久化事实对象" style="swimlane;startSize=38;horizontal=1;rounded=1;arcSize=8;container=1;collapsible=0;pointerEvents=0;whiteSpace=wrap;html=1;fontFamily=PingFang SC;fontSize=16;fontStyle=1;fontColor=#3E4B2B;fillColor=#F7FAF4;swimlaneFillColor=#FFFFFF;strokeColor=#A7BC8D;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="50" y="390" width="1900" height="260" as="geometry" />
        </mxCell>
        <mxCell id="messages" value="&lt;b&gt;消息序列&lt;/b&gt;&#xa;用户原文 + assistant 结构化载荷&#xa;按 sequence 顺序恢复" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontSize=13;spacing=7;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;" vertex="1" parent="lane_facts">
          <mxGeometry x="20" y="75" width="270" height="135" as="geometry" />
        </mxCell>
        <mxCell id="user_turn" value="&lt;b&gt;用户提交记录&lt;/b&gt;&#xa;clientTurnId・原话・对话位置&#xa;processing / completed / failed / canceled" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontSize=13;spacing=7;fillColor=#E6F3E3;strokeColor=#82B366;strokeWidth=1.5;" vertex="1" parent="lane_facts">
          <mxGeometry x="320" y="65" width="270" height="155" as="geometry" />
        </mxCell>
        <mxCell id="version_snapshot" value="&lt;b&gt;通用版本快照&lt;/b&gt;&#xa;每轮新增 version&#xa;兼容字段・置信度・缺失槽位" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontSize=13;spacing=7;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=1.5;" vertex="1" parent="lane_facts">
          <mxGeometry x="620" y="75" width="270" height="135" as="geometry" />
        </mxCell>
        <mxCell id="event" value="&lt;b&gt;当前事件&lt;/b&gt;&#xa;active ↔ ready_for_choice → completed&#xa;snapshotData・progressData" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontSize=13;spacing=7;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;" vertex="1" parent="lane_facts">
          <mxGeometry x="920" y="65" width="270" height="155" as="geometry" />
        </mxCell>
        <mxCell id="session" value="&lt;b&gt;会话主记录&lt;/b&gt;&#xa;active ↔ paused&#xa;completed → active（重开）&#xa;日期・维度・当前事件・总轮数" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontSize=13;spacing=7;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1.5;" vertex="1" parent="lane_facts">
          <mxGeometry x="1220" y="65" width="270" height="155" as="geometry" />
        </mxCell>
        <mxCell id="journal" value="&lt;b&gt;日志成果&lt;/b&gt;&#xa;draft → saved&#xa;正式保存推动会话 finalize&#xa;关联来源事件与会话" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontSize=13;spacing=7;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.5;" vertex="1" parent="lane_facts">
          <mxGeometry x="1520" y="75" width="270" height="135" as="geometry" />
        </mxCell>

        <mxCell id="lane_restore" value="③ 服务端重建与客户端恢复" style="swimlane;startSize=38;horizontal=1;rounded=1;arcSize=8;container=1;collapsible=0;pointerEvents=0;whiteSpace=wrap;html=1;fontFamily=PingFang SC;fontSize=16;fontStyle=1;fontColor=#704412;fillColor=#FFF9F1;swimlaneFillColor=#FFFFFF;strokeColor=#D8AA6D;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="50" y="710" width="1900" height="450" as="geometry" />
        </mxCell>
        <mxCell id="selector" value="&lt;b&gt;客户端恢复选择器&lt;/b&gt;&#xa;date::dimension 会话缓存&#xa;输入草稿与待发 outbox&#xa;显式 sessionId / entryDate・日历候选" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontSize=14;spacing=8;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.5;" vertex="1" parent="lane_restore">
          <mxGeometry x="70" y="105" width="390" height="145" as="geometry" />
        </mxCell>
        <mxCell id="read_map" value="&lt;b&gt;鉴权读取与会话重建&lt;/b&gt;&#xa;读取事件 / 消息 / 最新快照 / 日志&#xa;读取未完成的用户提交记录&#xa;合成完整 Session 读模型" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontSize=14;spacing=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="lane_restore">
          <mxGeometry x="530" y="95" width="430" height="165" as="geometry" />
        </mxCell>
        <mxCell id="projection" value="&lt;b&gt;产品状态投影&lt;/b&gt;&#xa;事件状态 → pendingDecision 选择卡&#xa;未完成提交 → pendingUserTurn&#xa;opening-only → 未开始 / 日历隐藏&#xa;重新计算日志生成权限" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontSize=14;spacing=8;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1.5;" vertex="1" parent="lane_restore">
          <mxGeometry x="1030" y="90" width="430" height="175" as="geometry" />
        </mxCell>
        <mxCell id="hydrate" value="&lt;b&gt;界面恢复&lt;/b&gt;&#xa;对话・当前问题・选择卡&#xa;待处理回复与“继续生成”&#xa;日期维度・进度・日志状态" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontSize=14;spacing=8;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;" vertex="1" parent="lane_restore">
          <mxGeometry x="1530" y="105" width="310" height="145" as="geometry" />
        </mxCell>
        <mxCell id="restore_note" value="失败或取消的回复保留用户原话；“继续生成”复用同一 clientTurnId，并增加尝试次数。普通入口只自动恢复今天，显式日期只恢复同日。" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontSize=14;fontColor=#704412;spacing=8;fillColor=#FFF9F1;strokeColor=#D8AA6D;" vertex="1" parent="lane_restore">
          <mxGeometry x="440" y="330" width="1020" height="70" as="geometry" />
        </mxCell>

