        <mxCell id="e3" value="追加助手消息" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=PingFang SC;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#6C8EBF;exitX=0.05;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="transaction" target="messages"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="300" y="370" /></Array></mxGeometry></mxCell>
