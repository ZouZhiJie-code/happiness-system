<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" modified="2026-07-18T00:00:00.000Z" agent="Codex" version="30.2.6">
  <diagram id="action-decision" name="动作决策层">
    <mxGraphModel dx="1600" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="访谈功能｜动作决策层功能架构" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=28;fontStyle=1;fontColor=#4A3428;" vertex="1" parent="1">
          <mxGeometry x="150" y="20" width="1400" height="60" as="geometry" />
        </mxCell>
        <mxCell id="input-layer" value="01  决策输入｜系统拿什么做判断" style="swimlane;startSize=40;horizontal=1;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF9F2;swimlaneFillColor=#FFFCF8;strokeColor=#D8BFA8;fontColor=#5A4032;fontSize=17;fontStyle=1;collapsible=0;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="100" y="100" width="1500" height="230" as="geometry" />
        </mxCell>
        <mxCell id="input-intent" value="&lt;b&gt;用户控制信号&lt;/b&gt;&lt;br&gt;显式按钮：继续当前事件 / 下一事件&lt;br&gt;自然语言：正常内容 / 整理日志 / 停止 / 反馈 / 修复" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#7EA6CC;fontColor=#28465F;fontSize=15;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="input-layer">
          <mxGeometry x="40" y="70" width="440" height="120" as="geometry" />
        </mxCell>
        <mxCell id="input-state" value="&lt;b&gt;当前内容状态&lt;/b&gt;&lt;br&gt;维度 + 最新事件档案 snapshot&lt;br&gt;阶段 stage + 核心 / 完整槽位是否成立" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EDF8;strokeColor=#9B7DB5;fontColor=#4D3B61;fontSize=15;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="input-layer">
          <mxGeometry x="530" y="70" width="440" height="120" as="geometry" />
        </mxCell>
        <mxCell id="input-progress" value="&lt;b&gt;过程控制状态&lt;/b&gt;&lt;br&gt;有效回复轮数 + 探索轮次&lt;br&gt;本轮是否产生新进展 + 当前 pendingDecision" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF6F0;strokeColor=#79A487;fontColor=#315640;fontSize=15;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="input-layer">
          <mxGeometry x="1020" y="70" width="440" height="120" as="geometry" />
        </mxCell>
        <mxCell id="decision-layer" value="02  决策核心｜按固定优先级运行（服务端规则）" style="swimlane;startSize=40;horizontal=1;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7E8;swimlaneFillColor=#FFFCF5;strokeColor=#D6A94F;fontColor=#5D4317;fontSize=17;fontStyle=1;collapsible=0;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="100" y="380" width="1500" height="610" as="geometry" />
        </mxCell>
        <mxCell id="decision-1" value="&lt;b&gt;优先级 1｜显式操作路由&lt;/b&gt;&lt;br&gt;继续当前事件 → 恢复同一事件并开启新探索轮次　｜　下一事件 → 完成旧事件并创建空事件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6A94F;fontColor=#5D4317;fontSize=15;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="decision-layer">
          <mxGeometry x="250" y="70" width="1000" height="95" as="geometry" />
        </mxCell>
        <mxCell id="decision-2" value="&lt;b&gt;优先级 2｜高优先级控制意图&lt;/b&gt;&lt;br&gt;整理日志 / 停止边界 / 对话反馈：跳过抽取，先按现有证据判断&lt;br&gt;会话或当前事件证据足够 → 当前版本完成；证据不足 → 低压选择" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE9C7;strokeColor=#D79B00;fontColor=#684A12;fontSize=15;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="decision-layer">
          <mxGeometry x="250" y="195" width="1000" height="115" as="geometry" />
        </mxCell>
        <mxCell id="decision-3" value="&lt;b&gt;优先级 3｜低信息与问题修复&lt;/b&gt;&lt;br&gt;低信息：保持事件状态与计数，邀请用户补全原话&lt;br&gt;问题修复：固定规则重问；第 3 次修复 → 低压选择" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE1B3;strokeColor=#CC8500;fontColor=#684A12;fontSize=15;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="decision-layer">
          <mxGeometry x="250" y="340" width="1000" height="115" as="geometry" />
        </mxCell>
        <mxCell id="decision-4" value="&lt;b&gt;优先级 4｜正常内容的完成与分支判断&lt;/b&gt;&lt;br&gt;完整版本：完整证据 + wrap_up + 有效回复　｜　当前版本：部分证据 + 用户请求提前整理&lt;br&gt;部分版本首次探索最低回复：开心 3；其他维度 2；后续探索要求本轮产生新进展&lt;br&gt;开心仍无可信时刻且命中条件 → 建议转去改进；其余情况 → 进入追问目标规划" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFD7A1;strokeColor=#C47A00;fontColor=#684A12;fontSize=15;spacing=14;align=left;verticalAlign=middle;" vertex="1" parent="decision-layer">
          <mxGeometry x="250" y="485" width="1000" height="95" as="geometry" />
        </mxCell>
        <mxCell id="output-layer" value="" style="swimlane;startSize=0;horizontal=1;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F7F7F5;swimlaneFillColor=#FCFCFA;strokeColor=#AAA59D;fontColor=#4D4943;fontSize=17;fontStyle=1;collapsible=0;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="100" y="1040" width="1500" height="250" as="geometry" />
        </mxCell>
        <mxCell id="output-continue" value="&lt;b&gt;A｜系统继续执行&lt;/b&gt;&lt;br&gt;普通追问 / 低信息邀请 / 确定性修复&lt;br&gt;继续当前事件 / 创建下一事件&lt;br&gt;&lt;font color=&quot;#52708C&quot;&gt;事件保持 active&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#7EA6CC;fontColor=#28465F;fontSize=15;spacing=12;align=left;verticalAlign=middle;" vertex="1" parent="output-layer">
          <mxGeometry x="30" y="45" width="330" height="165" as="geometry" />
        </mxCell>
        <mxCell id="output-complete" value="&lt;b&gt;B｜事件完成 event_complete&lt;/b&gt;&lt;br&gt;完整 complete 或当前版本 partial&lt;br&gt;继续深挖 / 换事件 / 生成日志&lt;br&gt;&lt;font color=&quot;#477554&quot;&gt;事件进入 ready_for_choice&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F2E7;strokeColor=#79A487;fontColor=#315640;fontSize=15;spacing=12;align=left;verticalAlign=middle;" vertex="1" parent="output-layer">
          <mxGeometry x="400" y="45" width="330" height="165" as="geometry" />
        </mxCell>
        <mxCell id="output-insufficient" value="&lt;b&gt;C｜材料不足 boundary_insufficient&lt;/b&gt;&lt;br&gt;停止边界或第 3 次问题修复&lt;br&gt;只补一句 / 换片段 / 先退出&lt;br&gt;&lt;font color=&quot;#9A6417&quot;&gt;事件进入 ready_for_choice&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0D8;strokeColor=#D29A43;fontColor=#684A12;fontSize=15;spacing=12;align=left;verticalAlign=middle;" vertex="1" parent="output-layer">
          <mxGeometry x="770" y="45" width="330" height="165" as="geometry" />
        </mxCell>
        <mxCell id="output-redirect" value="&lt;b&gt;D｜维度转向 dimension_redirect&lt;/b&gt;&lt;br&gt;当前仅用于开心 → 改进&lt;br&gt;继续找开心 / 切换到改进&lt;br&gt;&lt;font color=&quot;#76528A&quot;&gt;事件进入 ready_for_choice&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EAF7;strokeColor=#9B7DB5;fontColor=#4D3B61;fontSize=15;spacing=12;align=left;verticalAlign=middle;" vertex="1" parent="output-layer">
          <mxGeometry x="1140" y="45" width="330" height="165" as="geometry" />
        </mxCell>
