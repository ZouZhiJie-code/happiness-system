  <diagram name="证据校验与状态合并">
    <mxGraphModel dx="1900" dy="920" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1940" pageHeight="940" math="0" shadow="0">
      <root>
        <mxCell id="0" />
