        <mxCell id="2" value="访谈中的证据校验与状态合并" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=PingFang SC;fontSize=28;fontStyle=1;fontColor=#2F2A24;" vertex="1" parent="1">
