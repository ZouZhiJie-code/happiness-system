        <mxCell id="16" value="SSE 流式输出&#xa;turn → phase / delta → session&#xa;最终摘要与问题统一缓冲后分块展示" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=15;fontColor=#243B53;spacing=8;" vertex="1" parent="1">
