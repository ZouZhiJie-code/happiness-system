        </mxCell>
        <mxCell id="node9" value="⑨ 交给节点九&#xa;服务端检查与输出控制" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontFamily=PingFang SC;fontSize=14;fontStyle=1;fontColor=#27552A;spacing=8;" vertex="1" parent="mainLane">
