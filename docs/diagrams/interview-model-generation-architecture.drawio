<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="30.2.6">
  <diagram id="node8-model-generation" name="节点八-模型生成">
    <mxGraphModel dx="2200" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="节点八｜模型生成：把既定访谈任务转成自然对话" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=PingFang SC;fontSize=26;fontStyle=1;fontColor=#2D3748;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1500" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="流程权限归服务端｜模型生成 thinkingSummary 与一个 question｜异常时采用确定性问题继续访谈" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=PingFang SC;fontSize=14;fontColor=#5F6B7A;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1600" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="mainLane" value="节点八主链｜对话回复生成" style="swimlane;startSize=40;horizontal=1;rounded=1;html=1;whiteSpace=wrap;fillColor=#F8FAFC;swimlaneFillColor=#FFFFFF;strokeColor=#B8C5D6;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=16;fontStyle=1;fontColor=#334155;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="2120" height="420" as="geometry"/>
        </mxCell>

        <mxCell id="promptInput" value="① 节点七输出&#xa;问题 Prompt&#xa;维度·阶段·快照·questionSpec" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=14;fontStyle=1;fontColor=#1E3A5F;spacing=8;" vertex="1" parent="mainLane">
          <mxGeometry x="50" y="150" width="210" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="provider" value="② 解析 Chat Provider&#xa;数据库发布配置优先&#xa;环境方舟配置兜底" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=14;fontStyle=1;fontColor=#6B3C00;spacing=8;" vertex="1" parent="mainLane">
          <mxGeometry x="320" y="150" width="210" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="modeDecision" value="③ 有流式回调且&#xa;Provider 支持 stream？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=14;fontStyle=1;fontColor=#5C4800;spacing=4;" vertex="1" parent="mainLane">
          <mxGeometry x="590" y="145" width="170" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="streamCall" value="④ 流式模型调用&#xa;temperature 0.45&#xa;maxTokens 500" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=14;fontStyle=1;fontColor=#4A2858;spacing=8;" vertex="1" parent="mainLane">
          <mxGeometry x="830" y="70" width="210" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="completeCall" value="⑤ 非流式模型调用&#xa;普通请求直接调用&#xa;流式失败时同 Provider 重试" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=14;fontStyle=1;fontColor=#4A2858;spacing=8;" vertex="1" parent="mainLane">
          <mxGeometry x="830" y="225" width="210" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="markerParser" value="⑥ 标记解析器&#xa;SUMMARY 段&#xa;QUESTION 段" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=14;fontStyle=1;fontColor=#1E3A5F;spacing=8;" vertex="1" parent="mainLane">
          <mxGeometry x="1110" y="150" width="190" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="segments" value="⑦ 两段生成结果&#xa;thinkingSummary&#xa;question" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=14;fontStyle=1;fontColor=#27552A;spacing=8;" vertex="1" parent="mainLane">
          <mxGeometry x="1370" y="150" width="190" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="assemble" value="⑧ 服务端组装 Assistant Turn&#xa;沿用 questionSpec&#xa;问题表层协议·长度限制·固定状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=14;fontStyle=1;fontColor=#1E3A5F;spacing=8;" vertex="1" parent="mainLane">
