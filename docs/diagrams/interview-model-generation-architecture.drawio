        </mxCell>
        <mxCell id="extractRequest" value="⑪ 抽取 Prompt＋维度 Schema&#xa;非流式 completeStructuredOutput&#xa;temperature 0.15｜最多 2 次" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=14;fontStyle=1;fontColor=#4A2858;spacing=8;" vertex="1" parent="extractLane">
