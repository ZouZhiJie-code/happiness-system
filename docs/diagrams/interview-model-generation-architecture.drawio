        </mxCell>
        <mxCell id="extractResult" value="⑫ 结构化 JSON 校验与合并&#xa;成功：AI 结果优先，规则补空&#xa;失败：保守规则快照" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=14;fontStyle=1;fontColor=#27552A;spacing=8;" vertex="1" parent="extractLane">
          <mxGeometry x="820" y="80" width="360" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="boundaryNote" value="确定性分支直接跳过节点八：&#xa;问题修复｜停止边界｜事件完成｜维度转向&#xa;&#xa;日志草稿生成使用另一套 Prompt、Schema、质量门与 fallback。" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=1.2;fontFamily=PingFang SC;fontSize=13;fontColor=#475569;spacing=10;align=left;" vertex="1" parent="extractLane">
