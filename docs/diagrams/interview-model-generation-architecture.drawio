        <mxCell id="fallback" value="⑩ 确定性 fallback&#xa;Provider 缺失 / 调用失败 / 空输出&#xa;按维度·阶段·questionSpec 生成问题" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=14;fontStyle=1;fontColor=#6B2220;spacing=8;" vertex="1" parent="mainLane">
