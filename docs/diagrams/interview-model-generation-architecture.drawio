        <mxCell id="extractLane" value="相邻调用边界｜结构化槽位抽取属于节点二，与本节点是两次独立模型调用" style="swimlane;startSize=40;horizontal=1;rounded=1;html=1;whiteSpace=wrap;fillColor=#F8FAFC;swimlaneFillColor=#FFFFFF;strokeColor=#B8C5D6;strokeWidth=1.5;fontFamily=PingFang SC;fontSize=16;fontStyle=1;fontColor=#334155;pointerEvents=0;" vertex="1" parent="1">
