        </mxCell>
        <mxCell id="root" value="Daily Light｜五维度幸福日志&#xa;产品目标：让用户通过五种视角记录今天，形成可回看的自我理解&#xa;核心对象：维度会话 → 维度日志 → 当天整合日志" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#6f4e37;strokeColor=#5c3f2d;fontColor=#ffffff;fontSize=18;fontStyle=1;align=left;spacingLeft=24;" vertex="1" parent="1">
          <mxGeometry x="40" y="115" width="2060" height="90" as="geometry" />
        </mxCell>
        <mxCell id="main_path" value="核心对象与成果生命周期：五维入口  →  维度访谈  →  维度日志  →  当天整合日志  →  日历 / 分析 / 画像" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#5d4a16;fontSize=15;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="215" width="2060" height="44" as="geometry" />
