  <diagram name="Daily Light 版本一 五维度产品功能架构">
    <mxGraphModel dx="2100" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2140" pageHeight="1440" math="0" shadow="0">
