        <mxCell id="title" value="Daily Light 版本一｜五维度幸福日志产品功能架构" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=25;fontStyle=1;fontColor=#4f3526;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="2060" height="44" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="当前 Production 主链｜从用户选择的五种自我视角出发，形成维度日志、当天整合与长期认识" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontColor=#7a6253;" vertex="1" parent="1">
