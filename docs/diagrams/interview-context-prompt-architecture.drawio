  <diagram id="node7-context-prompt" name="节点七">
    <mxGraphModel dx="2000" dy="1240" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1240" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="节点七｜上下文与 Prompt 组装" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=PingFang SC;fontSize=28;fontStyle=1;fontColor=#2F3A4A;" vertex="1" parent="1">
          <mxGeometry x="50" y="20" width="900" height="50" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="把上游已经确定的追问方向，整理成模型可执行的 system + user 两条消息" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=PingFang SC;fontSize=15;fontColor=#667085;" vertex="1" parent="1">
          <mxGeometry x="50" y="70" width="1100" height="35" as="geometry" />
        </mxCell>

        <mxCell id="lane_sources" value="① 多源上下文" style="swimlane;startSize=38;horizontal=1;rounded=1;arcSize=8;container=1;collapsible=0;pointerEvents=0;whiteSpace=wrap;html=1;fontFamily=PingFang SC;fontSize=16;fontStyle=1;fontColor=#26415E;fillColor=#F4F8FC;swimlaneFillColor=#FFFFFF;strokeColor=#9BB7D3;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="50" y="120" width="1900" height="250" as="geometry" />
        </mxCell>
        <mxCell id="source_control" value="&lt;b&gt;控制状态&lt;/b&gt;&#xa;维度・动作・阶段&#xa;questionSpec・轮次&#xa;深度与覆盖视角" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontSize=15;spacing=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;" vertex="1" parent="lane_sources">
          <mxGeometry x="70" y="70" width="350" height="130" as="geometry" />
        </mxCell>
        <mxCell id="source_event" value="&lt;b&gt;事件状态&lt;/b&gt;&#xa;当前事件最新快照&#xa;全部事件摘要&#xa;探索轮次与事件状态" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontSize=15;spacing=8;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;" vertex="1" parent="lane_sources">
          <mxGeometry x="510" y="70" width="350" height="130" as="geometry" />
        </mxCell>
        <mxCell id="source_dialogue" value="&lt;b&gt;对话与可选记忆&lt;/b&gt;&#xa;本轮用户输入&#xa;近期对话・assistant 载荷&#xa;同维度历史记忆摘要" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontSize=15;spacing=8;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.5;" vertex="1" parent="lane_sources">
          <mxGeometry x="950" y="70" width="350" height="130" as="geometry" />
        </mxCell>
