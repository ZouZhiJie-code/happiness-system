        <mxCell id="transform_semantic" value="&lt;b&gt;服务端语义解释&lt;/b&gt;&#xa;主题・成立原因・追问焦点&#xa;问题提示・防写平目标&#xa;由确定性规则生成" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontSize=15;spacing=8;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1.5;" vertex="1" parent="lane_transform">
          <mxGeometry x="650" y="70" width="400" height="130" as="geometry" />
        </mxCell>
        <mxCell id="transform_window" value="&lt;b&gt;固定窗口与记忆筛选&lt;/b&gt;&#xa;可读对话最近 8 条&#xa;assistant 原始载荷最近 3 条&#xa;记忆默认最多 5 条" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontSize=15;spacing=8;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.5;" vertex="1" parent="lane_transform">
          <mxGeometry x="1180" y="70" width="400" height="130" as="geometry" />
