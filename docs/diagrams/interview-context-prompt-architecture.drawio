          <mxGeometry x="1390" y="70" width="350" height="130" as="geometry" />
        </mxCell>

        <mxCell id="lane_transform" value="② 筛选与结构化" style="swimlane;startSize=38;horizontal=1;rounded=1;arcSize=8;container=1;collapsible=0;pointerEvents=0;whiteSpace=wrap;html=1;fontFamily=PingFang SC;fontSize=16;fontStyle=1;fontColor=#3E4B2B;fillColor=#F7FAF4;swimlaneFillColor=#FFFFFF;strokeColor=#A7BC8D;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="50" y="410" width="1900" height="260" as="geometry" />
        </mxCell>
        <mxCell id="transform_projection" value="&lt;b&gt;维度化状态投影&lt;/b&gt;&#xa;把内部快照转换为&#xa;开心 / 充实 / 思考 / 改进 / 感谢&#xa;各自的字段表达" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontSize=15;spacing=8;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;" vertex="1" parent="lane_transform">
          <mxGeometry x="120" y="70" width="400" height="130" as="geometry" />
