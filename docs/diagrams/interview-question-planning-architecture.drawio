        <mxCell id="5" value="② 当前维度与阶段&#xa;五个维度 + 当前访谈位置" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=15;fontColor=#243B53;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="340" y="120" width="260" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="6" value="③ 最新事件档案&#xa;已有哪些材料、还缺哪一层" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=15;fontColor=#243B53;spacing=8;" vertex="1" parent="1">
