        <mxCell id="2" value="节点六｜追问目标规划" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#3D332C;" vertex="1" parent="1">
