        <mxCell id="4" value="① 动作决策结果&#xa;继续追问 / 继续深挖 / 问题修复" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=15;fontColor=#243B53;spacing=8;" vertex="1" parent="1">
