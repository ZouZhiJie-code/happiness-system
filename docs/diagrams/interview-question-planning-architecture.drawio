        <mxCell id="8" value="汇总规划上下文&#xa;本轮要继续问，并且只围绕当前事件" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=16;fontStyle=1;fontColor=#5C4813;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="430" y="270" width="380" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="9" value="A. 确定轮次意图&#xa;正常推进 advance&#xa;继续深挖 resume&#xa;问题修复 repair" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=15;fontColor=#6B3E00;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="440" width="300" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="10" value="B. 选择通用问题目标&#xa;具体事件｜先前判断｜直接反应&#xa;原因证据｜可继续使用的线索&#xa;&#xa;优先级：显式指定 → 沿用上一目标 → 自动推导" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=15;fontColor=#6B3E00;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="430" y="420" width="380" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="11" value="C. 应用维度细化&#xa;开心：单列直接反应&#xa;思考：场景修复保护&#xa;感谢：行动 / 需要 / 原因 / 关系&#xa;改进、充实：映射为通用目标" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontSize=15;fontColor=#4A3155;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="870" y="420" width="300" height="180" as="geometry"/>
        </mxCell>

        <mxCell id="12" value="D. 补全问题规格&#xa;表达层级：常规 / 简化 / 具体锚点&#xa;事件锚点：取用户已经讲过的片段&#xa;修复计数：控制问题逐步降压" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=15;fontColor=#5C4813;spacing=8;" vertex="1" parent="1">
