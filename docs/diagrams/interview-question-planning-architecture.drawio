        <mxCell id="13" value="问题规格 QuestionSpec&#xa;&#xa;目标 target｜维度细分 subTarget&#xa;轮次意图 stageIntent｜表达层级 surfaceLevel&#xa;事件锚点 anchorText｜修复次数 repairCount" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=3;fontSize=15;fontStyle=1;fontColor=#274E2B;spacing=10;" vertex="1" parent="1">
