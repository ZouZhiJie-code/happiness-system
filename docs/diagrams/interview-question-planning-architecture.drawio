        </mxCell>
        <mxCell id="7" value="④ 上一问题与修复信号&#xa;保留方向、降低回答负担" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=15;fontColor=#243B53;spacing=8;" vertex="1" parent="1">
