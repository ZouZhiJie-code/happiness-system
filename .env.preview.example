# Vercel preview environment contract
DATABASE_URL="" # dedicated Preview database, append ?schema=gi088_app_preview
DIRECT_URL="" # same Preview database on the unpooled host for app migrations, append ?schema=gi088_app_preview
# GI-088 的应用登录数据与评测数据使用同一个专属 Preview 物理库、两个隔离 schema；两者都不得指向 Production 数据库。
EVALUATION_DATABASE_URL="" # same Preview host/database, append ?schema=gi088_evaluation_v0
EVALUATION_DATABASE_URL_UNPOOLED="" # direct Preview connection for evaluation migrations; evaluation runtime uses EVALUATION_DATABASE_URL
EVALUATION_POSTGRES_HOST="" # Neon integration fact; must match EVALUATION_DATABASE_URL
EVALUATION_PGHOST_UNPOOLED="" # Neon direct-host identity; required when EVALUATION_DATABASE_URL_UNPOOLED is selected
EVALUATION_POSTGRES_DATABASE="" # Neon integration fact; must match EVALUATION_DATABASE_URL path
GI088_EVALUATION_DATABASE_SCHEMA="gi088_evaluation_v0"
GI088_EVALUATION_SCHEMA_DEPLOY="" # set I_UNDERSTAND only for the one-time schema migration command
GI088_EVALUATION_ENABLED="" # set I_UNDERSTAND only on the private GI-088 Preview
ADMIN_USERNAMES="" # Preview admin allowlist
GI088_EVALUATOR_USERNAMES="" # evaluator allowlist; access requires intersection with ADMIN_USERNAMES
GI088_MODEL_CALL_SCOPE="disabled" # disabled | smoke_off | smoke_high | batch; keep disabled by default, final v8r3 human run uses batch only in the authorized private Preview
GI088_EMPTY_CONTENT_AUTO_RECOVERY_RETRIES="2" # 1 restores the prior fallback; 2 is the v8r3r2 default
GI088_AUTHORIZED_EXECUTION_FINGERPRINT="" # deployment injects the final immutable v8r3r2 execution fingerprint
GI088_V8R3_CANDIDATE_OFFLINE_RUN_FINGERPRINT="" # final offline candidate run SHA-256
GI088_V8R3_CANDIDATE_EVIDENCE_FINGERPRINT="" # final offline evidence bundle SHA-256
GI088_V8R3_OFFLINE_AUTOMATIC_RECOVERY_COUNT="" # non-negative integer frozen from the offline candidate ledger
GI088_V8R3_ADMISSION_FINGERPRINT="" # optional: inject the final Admission report-v3 SHA-256 after formal admission; an empty value keeps the quality gate pending
GI088_SMOKE_AUTHORIZATION_ID="" # new UUID for each separately approved technical smoke
AI_RUNTIME_CONFIG_SECRET=""
CRON_SECRET=""
AI_PROVIDER="openai" # DeepSeek 官方 API 走 OpenAI 兼容协议
INTERVIEW_INTENT_V2_MODE="enforce"
INTERVIEW_EVENT_CENTERED_MODE="optional" # private Preview only; Production remains legacy
INTERVIEW_EVENT_CENTERED_STRATEGY="generative" # optional: private Board 8 Preview only; Production remains baseline
EVENT_CENTERED_GENERATIVE_MODEL="deepseek-v4-flash" # generic compatibility default; GI-088 v8r3 uses its dedicated Ark Flash / Thinking high runtime
INTERVIEW_REGENERATION_ENABLED="true"
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-v4-pro"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
VOLCENGINE_ARK_API_KEY="" # required for the GI-088 v8r3 Ark Flash Preview candidate
VOLCENGINE_ARK_MODEL="deepseek-v4-flash-ga-260731" # optional: shared runtime override; GI-088 v8r3 freezes this model internally
VOLCENGINE_ARK_BASE_URL="https://ark.cn-beijing.volces.com/api/v3" # GI-088 v8r3 freezes this exact Preview endpoint
# 事件中心离线评测：策略回放采用上方 DEEPSEEK_*；Judge 显式使用更高标准模型。
EVENT_CENTERED_JUDGE_DEEPSEEK_MODEL="deepseek-v4-pro"
EVENT_CENTERED_JUDGE_TIMEOUT_MS="20000"
VOLCENGINE_ARK_EMBEDDING_ENDPOINT_ID="" # optional: legacy embedding path only
APP_URL="https://your-project-git-branch-your-team.vercel.app" # optional: user-defined APP_URL is optional only when Vercel system env exposure/runtime readback is verified elsewhere
