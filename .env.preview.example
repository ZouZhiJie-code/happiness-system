# Vercel preview environment contract
DATABASE_URL="" # dedicated Preview database, append ?schema=gi088_app_preview
# GI-088 的应用登录数据与评测数据使用同一个专属 Preview 物理库、两个隔离 schema；两者都不得指向 Production 数据库。
EVALUATION_DATABASE_URL="" # same Preview host/database, append ?schema=gi088_evaluation_v0
EVALUATION_DATABASE_URL_UNPOOLED="" # direct Preview connection for migrations; app runtime prefers EVALUATION_DATABASE_URL
EVALUATION_POSTGRES_HOST="" # Neon integration fact; must match EVALUATION_DATABASE_URL
EVALUATION_PGHOST_UNPOOLED="" # Neon direct-host identity; required when EVALUATION_DATABASE_URL_UNPOOLED is selected
EVALUATION_POSTGRES_DATABASE="" # Neon integration fact; must match EVALUATION_DATABASE_URL path
GI088_EVALUATION_DATABASE_SCHEMA="gi088_evaluation_v0"
GI088_EVALUATION_SCHEMA_DEPLOY="" # set I_UNDERSTAND only for the one-time schema migration command
GI088_EVALUATION_ENABLED="" # set I_UNDERSTAND only on the private GI-088 Preview
ADMIN_USERNAMES="" # Preview admin allowlist
GI088_EVALUATOR_USERNAMES="" # evaluator allowlist; access requires intersection with ADMIN_USERNAMES
GI088_MODEL_CALL_SCOPE="disabled" # disabled | smoke_off | smoke_high | batch; keep disabled by default, final v8r2 human run uses batch only in the authorized private Preview
GI088_AUTHORIZED_EXECUTION_FINGERPRINT="" # final v8r2 immutable value: 55c0c9b0ef31f46bf638c3a90fd6323c1ef7ad83a14d367d4e2e2fe3cc34b34e
GI088_SMOKE_AUTHORIZATION_ID="" # new UUID for each separately approved technical smoke
AI_RUNTIME_CONFIG_SECRET=""
CRON_SECRET=""
AI_PROVIDER="openai" # DeepSeek 官方 API 走 OpenAI 兼容协议
INTERVIEW_INTENT_V2_MODE="enforce"
INTERVIEW_EVENT_CENTERED_MODE="legacy"
INTERVIEW_EVENT_CENTERED_STRATEGY="baseline" # optional: omitted values default to baseline; set generative only for Board 8 internal Preview
EVENT_CENTERED_GENERATIVE_MODEL="deepseek-v4-flash" # generic compatibility default; GI-088 v8r2 uses its dedicated DeepSeek V4 Pro / Thinking high runtime
INTERVIEW_REGENERATION_ENABLED="true"
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-v4-pro"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
VOLCENGINE_ARK_API_KEY="" # required only for the GI-088 v7r2 Ark Flash Preview candidate
VOLCENGINE_ARK_MODEL="" # optional: legacy rollback only; current chat uses DeepSeek official API
VOLCENGINE_ARK_BASE_URL="https://ark.cn-beijing.volces.com/api/v3" # GI-088 v7r2 freezes this exact Preview endpoint
# 事件中心离线评测：策略回放采用上方 DEEPSEEK_*；Judge 显式使用更高标准模型。
EVENT_CENTERED_JUDGE_DEEPSEEK_MODEL="deepseek-v4-pro"
EVENT_CENTERED_JUDGE_TIMEOUT_MS="20000"
VOLCENGINE_ARK_EMBEDDING_ENDPOINT_ID="" # optional: legacy embedding path only
APP_URL="https://your-project-git-branch-your-team.vercel.app" # optional: user-defined APP_URL is optional only when Vercel system env exposure/runtime readback is verified elsewhere
