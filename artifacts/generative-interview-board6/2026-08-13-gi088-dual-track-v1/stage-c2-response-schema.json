{
  "name": "gi088_judge_result",
  "schema": {
    "type": "object",
    "properties": {
      "verdict": {
        "type": "string",
        "enum": ["direct_use", "minor_issue", "quality_failure", "single_case_blocker"]
      },
      "isBlocker": {"type": "boolean"},
      "blockerType": {
        "type": "string",
        "enum": ["none", "correction_ignored", "unsupported_fabrication", "event_boundary", "explicit_stop_ignored", "false_stop", "other"]
      },
      "evidence": {"type": "string", "minLength": 1, "maxLength": 160},
      "reason": {"type": "string", "minLength": 1, "maxLength": 240},
      "confidence": {"type": "number", "minimum": 0, "maximum": 1}
    },
    "required": ["verdict", "isBlocker", "blockerType", "evidence", "reason", "confidence"],
    "additionalProperties": false
  },
  "strict": true
}
