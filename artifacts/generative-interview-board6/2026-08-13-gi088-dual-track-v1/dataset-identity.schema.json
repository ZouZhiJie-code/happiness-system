{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dailylight.chat/schemas/ai-evaluation-dataset-identity-v1.json",
  "title": "Daily Light AI 评测数据集身份证 v1",
  "type": "object",
  "required": [
    "datasetId",
    "version",
    "purpose",
    "supportedDecision",
    "collection",
    "itemCount",
    "coverageBlueprint",
    "sourceDistribution",
    "frozenAt",
    "visibility",
    "knownLimitations",
    "changeHistory"
  ],
  "properties": {
    "datasetId": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "supportedDecision": { "type": "string", "minLength": 1 },
    "collection": { "type": "string", "minLength": 1 },
    "itemCount": { "type": "integer", "minimum": 1 },
    "coverageBlueprint": { "type": "object" },
    "sourceDistribution": { "type": "object" },
    "frozenAt": { "type": "string", "format": "date-time" },
    "visibility": { "type": "string", "minLength": 1 },
    "knownLimitations": { "type": "array", "items": { "type": "string" } },
    "changeHistory": { "type": "array", "minItems": 1 }
  },
  "additionalProperties": true
}
