  feedback                       AIFeedback?
  fewShotExample                 AIFewShotExample?
  sourceResponseRegenerations    AIResponseRegeneration[]                   @relation("RegenerationSourceTrace")
  generatedResponseRegenerations AIResponseRegeneration[]                   @relation("RegenerationGeneratedTrace")
