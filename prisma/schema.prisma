  angleOutcomes                  JournalEventAngleOutcome[]                 @relation("JournalEventAngleOutcomeGenerationTrace")
  angleOutcomeRepairResolutions  JournalEventAngleOutcomeRepairResolution[] @relation("JournalEventAngleOutcomeRepairResolutionTrace")
