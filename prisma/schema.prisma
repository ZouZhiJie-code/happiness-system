  journalDailyEntryRevision      JournalDailyEntryRevision?                 @relation("JournalDailyEntryRevisionGenerationTrace")

  @@unique([artifactType, artifactId, artifactVersion])
  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
  @@index([journalEventId, createdAt])
  @@index([status, createdAt])
  @@index([artifactType, dimension, createdAt])
}

