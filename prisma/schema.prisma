generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum InterviewDimension {
  joy
  fulfillment
  reflection
  improvement
  gratitude
}

enum InterviewSessionStatus {
  active
  paused
  completed
  abandoned
}

enum InterviewSessionMode {
  dimension_legacy
  event_centered
}

enum InterviewRecordMode {
  capture
  chat
}

enum InterviewRole {
  user
  assistant
  system
}

enum InputMode {
  text
  voice
}

enum JoyInterviewStage {
  collect_event
  probe_reason
  probe_pattern
  wrap_up
  finalize
}

enum JoyEntrySource {
  ai_draft_direct
  ai_draft_edited
}

enum JoyEntryStatus {
  draft
  saved
}

enum DailyJournalStatus {
  draft
  saved
}

enum InterviewEventStatus {
  active
  ready_for_choice
  completed
}

enum JournalEventFactRevisionRelation {
  supplement
  supersede
  negate
  withdraw
  deprioritize
  restore_focus
}

enum JournalEventAngle {
  feeling
  thought
  relationship
  action
}

enum JournalEventAngleOutcomeKind {
  insight
  honest_limit
}

enum JournalEventAngleOutcomeFactRole {
  support
  context
}

enum JournalEventAngleOutcomeRepairDecision {
  replaced
  reopened
}

enum JournalEventUnderstandingClaimStatus {
  pending
  confirmed
  rejected
}

enum JournalEventStatus {
  active
  generating
  completed
  abandoned
}

enum JournalEventEntryStatus {
  draft
  saved
  modified
}

enum JournalEventEntryGenerationStatus {
  processing
  completed
  failed
  canceled
}

enum JournalDailyEntryStatus {
  draft
  saved
  modified
}

enum JournalDailyEntryRevisionKind {
  generated
  updated
  user_saved
}

enum JournalDailyEntryGenerationKind {
  generate
  update
}

enum JournalDailyEntryGenerationStatus {
  processing
  completed
  failed
  canceled
}

enum JournalPeriodKind {
  week
  month
}

enum JournalPeriodReportStatus {
  draft
  saved
  modified
}

enum JournalPeriodReportRevisionKind {
  generated
  updated
  user_saved
}

enum JournalPeriodReportGenerationKind {
  generate
  update
}

enum JournalPeriodReportGenerationStatus {
  processing
  completed
  failed
  canceled
}

enum JournalDayOwnershipStatus {
  clean
  mixed
}

enum JournalEventFactScope {
  current_event
  background
}

enum JournalEventFactStance {
  affirmed
  denied
  unknown
}

enum JournalEventFactKind {
  event_detail
  inner_experience
  stated_interpretation
  stated_preference
  boundary_answer
}

enum JournalEventFactOrigin {
  user_expression
  explicit_confirmation
  implicit_confirmation
}

enum JournalEventFactEvidenceRole {
  direct_expression
  event_selection
  short_confirmation
  repeated_support
  implicit_confirmation
}

enum AIRequestStage {
  transcribe
  extract
  generate
  question
  evaluate
  iterate
  portrait_synthesis
}

enum AIGenerationArtifactType {
  interview_turn
  dimension_journal
  event_journal
  daily_journal
  daily_journal_insight
}

enum AIGenerationTraceStatus {
  pending
  completed
  failed
  canceled
}

enum AIOutputOrigin {
  llm
  deterministic
  fallback
}

enum InterviewUserTurnAction {
  reply
  continue_current_event
  next_event
  regenerate_question
  correct_understanding
  generate_event_journal
  select_current_event
  select_exploration_angle
  continue_exploration
  exit_event
}

enum InterviewUserTurnStatus {
  processing
  completed
  failed
  canceled
}

enum InterviewRegenerationIntent {
  simplify
  concretize
  change_angle
  deepen
  lighten
}

enum AIResponseRegenerationStatus {
  processing
  completed
  failed
  canceled
}

enum AICaseClassification {
  bad
  review
  good
}

enum AIEvaluationStatus {
  rules_completed
  completed
  failed
}

enum AIEvaluationTrigger {
  routine
  risk
  sample
  user_feedback
  manual
}

enum AIFeedbackVote {
  upvote
  downvote
}

enum AIFeedbackStatus {
  active
  revoked
}

enum AIOptimizationPath {
  system_prompt
  few_shot
  engineering
}

enum AIOptimizationStatus {
  draft
  approved
  published
  rejected
  rolled_back
}

enum AIOptimizationRunStatus {
  running
  completed
  failed
}

enum AIOptimizationValidationStatus {
  running
  passed
  failed
  error
}

enum AIFewShotStatus {
  candidate
  active
  retired
}

enum MemorySourceType {
  ai_extracted
  user_added
}

enum AIRuntimeCapability {
  chat
  embedding
}

enum AIRuntimeProvider {
  openai
  anthropic
  volcengine_ark
}

enum AIRuntimeConfigStatus {
  draft
  published
  archived
}

model User {
  id                        String                        @id @default(cuid())
  username                  String                        @unique
  passwordHash              String
  agreedToTermsAt           DateTime
  agreedToPrivacyAt         DateTime
  privacyPolicyVersion      String                        @default("legacy")
  aiQualityConsentVersion   String?
  aiQualityConsentAt        DateTime?
  aiQualityConsentRevokedAt DateTime?
  createdAt                 DateTime                      @default(now())
  settings                  UserSettings?
  sessions                  InterviewSession[]
  journalEvents             JournalEvent[]
  joyEntries                JoyEntry[]
  dailyJournalEntries       DailyJournalEntry[]
  journalDailyEntries       JournalDailyEntry[]
  journalDailyGenerations   JournalDailyEntryGeneration[]
  journalPeriodReports      JournalPeriodReport[]
  journalPeriodGenerations  JournalPeriodReportGeneration[]
  journalDayOwnerships      JournalDayOwnership[]
  dailyHappinessScores      DailyHappinessScore[]
  memoryFacts               MemoryFact[]
  portraitSnapshots         PortraitSnapshot[]
  authSessions              AuthSession[]
  aiGenerationTraces        AIGenerationTrace[]
  aiFeedbacks               AIFeedback[]
}

model AuthSession {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  userAgent  String?
  ipAddress  String?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserSettings {
  id                            String   @id @default(cuid())
  userId                        String   @unique
  memoryEnabled                 Boolean  @default(false)
  transcriptAutoFallbackEnabled Boolean  @default(true)
  timezone                      String   @default("Asia/Shanghai")
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt
  user                          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InterviewSession {
  id                            String                                     @id @default(cuid())
  userId                        String
  startOperationId              String?
  sidebarTitle                  String?                                    @db.VarChar(80)
  lastActivityAt                DateTime                                   @default(now())
  mode                          InterviewSessionMode                       @default(dimension_legacy)
  recordMode                    InterviewRecordMode?
  dimension                     InterviewDimension?
  conversationSchemaVersion     Int                                        @default(1)
  rootSessionId                 String?
  parentSessionId               String?
  activeBranchSessionId         String?
  forkMessageSequence           Int?
  forkedFromMessageId           String?
  branchDepth                   Int                                        @default(0)
  status                        InterviewSessionStatus                     @default(active)
  stage                         JoyInterviewStage                          @default(collect_event)
  activeEventId                 String?
  turnCount                     Int                                        @default(0)
  entryDate                     DateTime
  startedAt                     DateTime                                   @default(now())
  pausedAt                      DateTime?
  completedAt                   DateTime?
  lastAssistantQuestion         String?
  draftSummary                  String?
  finalEntryId                  String?                                    @unique
  activeEvent                   InterviewEvent?                            @relation("ActiveInterviewEvent", fields: [activeEventId], references: [id], onDelete: SetNull)
  rootSession                   InterviewSession?                          @relation("InterviewSessionRoot", fields: [rootSessionId], references: [id], onDelete: SetNull)
  rootBranches                  InterviewSession[]                         @relation("InterviewSessionRoot")
  parentSession                 InterviewSession?                          @relation("InterviewSessionParent", fields: [parentSessionId], references: [id], onDelete: Cascade)
  childBranches                 InterviewSession[]                         @relation("InterviewSessionParent")
  activeBranchSession           InterviewSession?                          @relation("InterviewSessionActiveBranch", fields: [activeBranchSessionId], references: [id], onDelete: SetNull)
  activeForRootSessions         InterviewSession[]                         @relation("InterviewSessionActiveBranch")
  forkedFromMessage             InterviewMessage?                          @relation("InterviewSessionForkedFromMessage", fields: [forkedFromMessageId], references: [id], onDelete: SetNull)
  events                        InterviewEvent[]                           @relation("SessionInterviewEvents")
  messages                      InterviewMessage[]
  branchMessages                InterviewMessage[]                         @relation("InterviewMessageBranchSession")
  userTurns                     InterviewUserTurn[]
  basedUserTurns                InterviewUserTurn[]                        @relation("InterviewUserTurnBaseBranch")
  snapshots                     JoyInterviewSnapshot[]
  branchCheckpoints             InterviewBranchCheckpoint[]
  responseRegenerations         AIResponseRegeneration[]                   @relation("RegenerationBranchSession")
  rootResponseRegenerations     AIResponseRegeneration[]                   @relation("RegenerationRootSession")
  aiRequestLogs                 AIRequestLog[]
  aiGenerationTraces            AIGenerationTrace[]
  user                          User                                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  joyEntry                      JoyEntry?                                  @relation("SessionJoyEntry")
  journalEvent                  JournalEvent?                              @relation("JournalEventRootSession")
  createdJournalEventFacts      JournalEventFact[]                         @relation("JournalEventFactCreatedBranch")
  understandingClaims           JournalEventUnderstandingClaim[]           @relation("JournalEventUnderstandingClaimBranch")
  factRevisions                 JournalEventFactRevision[]                 @relation("JournalEventFactRevisionBranch")
  angleOutcomes                 JournalEventAngleOutcome[]                 @relation("JournalEventAngleOutcomeBranch")
  angleOutcomeRepairs           JournalEventAngleOutcomeRepair[]           @relation("JournalEventAngleOutcomeRepairBranch")
  angleOutcomeRepairResolutions JournalEventAngleOutcomeRepairResolution[] @relation("JournalEventAngleOutcomeRepairResolutionBranch")
  sourceJournalEventEntries     JournalEventEntry[]                        @relation("JournalEventEntrySourceBranch")
  journalEventEntryGenerations  JournalEventEntryGeneration[]              @relation("JournalEventEntryGenerationBranch")
  claimedJournalDayOwnerships   JournalDayOwnership[]                      @relation("JournalDayOwnershipClaimedBySession")

  @@index([userId, status])
  @@index([userId, entryDate])
  @@unique([userId, startOperationId])
  @@index([userId, mode, status, lastActivityAt])
  @@index([rootSessionId, branchDepth])
  @@index([parentSessionId])
  @@index([activeBranchSessionId])
  @@index([mode, userId, entryDate, status])
}

model JournalEvent {
  id                  String                           @id @default(cuid())
  userId              String
  rootSessionId       String                           @unique
  entryDate           DateTime
  daySequence         Int
  status              JournalEventStatus               @default(active)
  startedAt           DateTime                         @default(now())
  generationStartedAt DateTime?
  completedAt         DateTime?
  abandonedAt         DateTime?
  createdAt           DateTime                         @default(now())
  updatedAt           DateTime                         @updatedAt
  user                User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  rootSession         InterviewSession                 @relation("JournalEventRootSession", fields: [rootSessionId], references: [id], onDelete: Cascade)
  userTurns           InterviewUserTurn[]              @relation("JournalEventUserTurns")
  facts               JournalEventFact[]
  understandingClaims JournalEventUnderstandingClaim[]
  aiGenerationTraces  AIGenerationTrace[]              @relation("JournalEventGenerationTraces")
  factRevisions       JournalEventFactRevision[]
  angleOutcomes       JournalEventAngleOutcome[]
  angleOutcomeRepairs JournalEventAngleOutcomeRepair[]
  entry               JournalEventEntry?
  entryGenerations    JournalEventEntryGeneration[]

  @@unique([userId, entryDate, daySequence])
  @@index([userId, entryDate, status])
}

model JournalEventFact {
  id                     String                           @id @default(cuid())
  eventId                String
  createdBranchSessionId String
  pathAnchorMessageId    String
  createdByRevisionId    String?
  statement              String
  scope                  JournalEventFactScope
  stance                 JournalEventFactStance
  kind                   JournalEventFactKind
  origin                 JournalEventFactOrigin
  createdAt              DateTime                         @default(now())
  event                  JournalEvent                     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBranchSession   InterviewSession                 @relation("JournalEventFactCreatedBranch", fields: [createdBranchSessionId], references: [id], onDelete: Cascade)
  pathAnchorMessage      InterviewMessage                 @relation("JournalEventFactPathAnchor", fields: [pathAnchorMessageId], references: [id], onDelete: Cascade)
  createdByRevision      JournalEventFactRevision?        @relation("JournalEventFactCreatedByRevision", fields: [createdByRevisionId], references: [id], onDelete: Cascade)
  revisionTargets        JournalEventFactRevisionTarget[] @relation("JournalEventFactRevisionTargetFact")
  evidence               JournalEventFactEvidence[]
  confirmedClaim         JournalEventUnderstandingClaim?  @relation("JournalEventUnderstandingClaimConfirmedFact")
  angleOutcomeFacts      JournalEventAngleOutcomeFact[]

  @@index([eventId, createdAt])
  @@index([createdBranchSessionId, createdAt])
  @@index([pathAnchorMessageId])
  @@index([createdByRevisionId])
}

model JournalEventFactEvidence {
  id                  String                       @id @default(cuid())
  factId              String
  sourceTurnId        String
  contextMessageId    String?
  pathAnchorMessageId String
  role                JournalEventFactEvidenceRole
  quote               String?
  createdAt           DateTime                     @default(now())
  fact                JournalEventFact             @relation(fields: [factId], references: [id], onDelete: Cascade)
  sourceTurn          InterviewUserTurn            @relation(fields: [sourceTurnId], references: [id], onDelete: Cascade)
  contextMessage      InterviewMessage?            @relation("JournalEventFactEvidenceContext", fields: [contextMessageId], references: [id], onDelete: Cascade)
  pathAnchorMessage   InterviewMessage             @relation("JournalEventFactEvidencePathAnchor", fields: [pathAnchorMessageId], references: [id], onDelete: Cascade)

  @@unique([factId, sourceTurnId, role, pathAnchorMessageId], map: "JournalEventFactEvidence_dedupe_key")
  @@index([sourceTurnId, createdAt])
  @@index([contextMessageId])
  @@index([pathAnchorMessageId])
}

model JournalEventUnderstandingClaim {
  id                   String                               @id @default(cuid())
  eventId              String
  branchSessionId      String
  assistantMessageId   String                               @unique
  statement            String
  scope                JournalEventFactScope
  stance               JournalEventFactStance
  kind                 JournalEventFactKind
  status               JournalEventUnderstandingClaimStatus @default(pending)
  confirmedFactId      String?                              @unique
  confirmedByTurnId    String?                              @unique
  confirmedAt          DateTime?
  rejectedByRevisionId String?                              @unique
  rejectedByTurnId     String?
  rejectedAt           DateTime?
  createdAt            DateTime                             @default(now())
  event                JournalEvent                         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  branchSession        InterviewSession                     @relation("JournalEventUnderstandingClaimBranch", fields: [branchSessionId], references: [id], onDelete: Cascade)
  assistantMessage     InterviewMessage                     @relation(fields: [assistantMessageId], references: [id], onDelete: Cascade)
  confirmedFact        JournalEventFact?                    @relation("JournalEventUnderstandingClaimConfirmedFact", fields: [confirmedFactId], references: [id], onDelete: Cascade)
  confirmedByTurn      InterviewUserTurn?                   @relation("JournalEventUnderstandingClaimConfirmedByTurn", fields: [confirmedByTurnId], references: [id], onDelete: Cascade)
  rejectedByRevision   JournalEventFactRevision?            @relation("JournalEventUnderstandingClaimRejectedByRevision", fields: [rejectedByRevisionId], references: [id], onDelete: Cascade)
  rejectedByTurn       InterviewUserTurn?                   @relation("JournalEventUnderstandingClaimRejectedByTurn", fields: [rejectedByTurnId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
  @@index([branchSessionId, createdAt])
  @@index([rejectedByTurnId])
}

model JournalEventFactRevision {
  id                        String                           @id @default(cuid())
  eventId                   String
  branchSessionId           String
  sourceTurnId              String                           @unique
  clarificationSourceTurnId String?
  pathAnchorMessageId       String
  contextMessageId          String?
  quote                     String
  requestFingerprint        String
  decisionTraceId           String?                          @unique
  createdAt                 DateTime                         @default(now())
  event                     JournalEvent                     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  branchSession             InterviewSession                 @relation("JournalEventFactRevisionBranch", fields: [branchSessionId], references: [id], onDelete: Cascade)
  sourceTurn                InterviewUserTurn                @relation("JournalEventFactRevisionSourceTurn", fields: [sourceTurnId], references: [id], onDelete: Cascade)
  clarificationSourceTurn   InterviewUserTurn?               @relation("JournalEventFactRevisionClarificationSourceTurn", fields: [clarificationSourceTurnId], references: [id], onDelete: Cascade)
  pathAnchorMessage         InterviewMessage                 @relation("JournalEventFactRevisionPathAnchor", fields: [pathAnchorMessageId], references: [id], onDelete: Cascade)
  contextMessage            InterviewMessage?                @relation("JournalEventFactRevisionContext", fields: [contextMessageId], references: [id], onDelete: Cascade)
  decisionTrace             AIGenerationTrace?               @relation("JournalEventFactRevisionDecisionTrace", fields: [decisionTraceId], references: [id], onDelete: SetNull)
  targets                   JournalEventFactRevisionTarget[]
  createdFacts              JournalEventFact[]               @relation("JournalEventFactCreatedByRevision")
  rejectedClaim             JournalEventUnderstandingClaim?  @relation("JournalEventUnderstandingClaimRejectedByRevision")
  angleOutcomeRepairs       JournalEventAngleOutcomeRepair[]

  @@index([eventId, createdAt])
  @@index([branchSessionId, createdAt])
  @@index([clarificationSourceTurnId])
  @@index([pathAnchorMessageId])
  @@index([contextMessageId])
}

model JournalEventFactRevisionTarget {
  id           String                           @id @default(cuid())
  revisionId   String
  targetFactId String
  relation     JournalEventFactRevisionRelation
  createdAt    DateTime                         @default(now())
  revision     JournalEventFactRevision         @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  targetFact   JournalEventFact                 @relation("JournalEventFactRevisionTargetFact", fields: [targetFactId], references: [id], onDelete: Cascade)

  @@unique([revisionId, targetFactId, relation], map: "JournalEventFactRevisionTarget_dedupe_key")
  @@index([targetFactId, createdAt])
}

model JournalEventAngleOutcome {
  id                    String                                    @id @default(cuid())
  eventId               String
  branchSessionId       String
  sourceTurnId          String
  assistantMessageId    String
  generationTraceId     String?
  angle                 JournalEventAngle
  kind                  JournalEventAngleOutcomeKind
  statement             String
  requestFingerprint    String
  createdAt             DateTime                                  @default(now())
  event                 JournalEvent                              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  branchSession         InterviewSession                          @relation("JournalEventAngleOutcomeBranch", fields: [branchSessionId], references: [id], onDelete: Cascade)
  sourceTurn            InterviewUserTurn                         @relation("JournalEventAngleOutcomeSourceTurn", fields: [sourceTurnId], references: [id], onDelete: Cascade)
  assistantMessage      InterviewMessage                          @relation("JournalEventAngleOutcomeAssistantMessage", fields: [assistantMessageId], references: [id], onDelete: Cascade)
  generationTrace       AIGenerationTrace?                        @relation("JournalEventAngleOutcomeGenerationTrace", fields: [generationTraceId], references: [id], onDelete: SetNull)
  facts                 JournalEventAngleOutcomeFact[]
  priorRepairs          JournalEventAngleOutcomeRepair[]          @relation("JournalEventAngleOutcomeRepairPrior")
  replacementResolution JournalEventAngleOutcomeRepairResolution? @relation("JournalEventAngleOutcomeRepairResolutionReplacement")

  @@unique([assistantMessageId, angle], map: "JournalEventAngleOutcome_assistantMessage_angle_key")
  @@index([eventId, angle, createdAt])
  @@index([branchSessionId, createdAt])
  @@index([sourceTurnId])
  @@index([assistantMessageId])
  @@index([generationTraceId])
}

model JournalEventAngleOutcomeFact {
  id        String                           @id @default(cuid())
  outcomeId String
  factId    String
  role      JournalEventAngleOutcomeFactRole
  createdAt DateTime                         @default(now())
  outcome   JournalEventAngleOutcome         @relation(fields: [outcomeId], references: [id], onDelete: Cascade)
  fact      JournalEventFact                 @relation(fields: [factId], references: [id], onDelete: Cascade)

  @@unique([outcomeId, factId], map: "JournalEventAngleOutcomeFact_dedupe_key")
  @@index([factId, role, createdAt])
}

model JournalEventAngleOutcomeRepair {
  id                  String                                     @id @default(cuid())
  eventId             String
  branchSessionId     String
  factRevisionId      String
  pathAnchorMessageId String
  priorOutcomeId      String
  angle               JournalEventAngle
  createdAt           DateTime                                   @default(now())
  event               JournalEvent                               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  branchSession       InterviewSession                           @relation("JournalEventAngleOutcomeRepairBranch", fields: [branchSessionId], references: [id], onDelete: Cascade)
  factRevision        JournalEventFactRevision                   @relation(fields: [factRevisionId], references: [id], onDelete: Cascade)
  pathAnchorMessage   InterviewMessage                           @relation("JournalEventAngleOutcomeRepairPathAnchor", fields: [pathAnchorMessageId], references: [id], onDelete: Cascade)
  priorOutcome        JournalEventAngleOutcome                   @relation("JournalEventAngleOutcomeRepairPrior", fields: [priorOutcomeId], references: [id], onDelete: Cascade)
  resolutions         JournalEventAngleOutcomeRepairResolution[]

  @@unique([factRevisionId, priorOutcomeId], map: "JournalEventAngleOutcomeRepair_revision_outcome_key")
  @@index([eventId, createdAt])
  @@index([branchSessionId, createdAt])
  @@index([pathAnchorMessageId])
  @@index([priorOutcomeId])
}

model JournalEventAngleOutcomeRepairResolution {
  id                    String                                 @id @default(cuid())
  repairId              String
  branchSessionId       String
  resolvedMessageId     String
  resolutionTraceId     String?
  decision              JournalEventAngleOutcomeRepairDecision
  replacementOutcomeId  String?                                @unique
  resolutionFingerprint String
  resolvedAt            DateTime                               @default(now())
  createdAt             DateTime                               @default(now())
  repair                JournalEventAngleOutcomeRepair         @relation(fields: [repairId], references: [id], onDelete: Cascade)
  branchSession         InterviewSession                       @relation("JournalEventAngleOutcomeRepairResolutionBranch", fields: [branchSessionId], references: [id], onDelete: Cascade)
  resolvedMessage       InterviewMessage                       @relation("JournalEventAngleOutcomeRepairResolutionMessage", fields: [resolvedMessageId], references: [id], onDelete: Cascade)
  resolutionTrace       AIGenerationTrace?                     @relation("JournalEventAngleOutcomeRepairResolutionTrace", fields: [resolutionTraceId], references: [id], onDelete: SetNull)
  replacementOutcome    JournalEventAngleOutcome?              @relation("JournalEventAngleOutcomeRepairResolutionReplacement", fields: [replacementOutcomeId], references: [id], onDelete: Cascade)

  @@unique([repairId, resolvedMessageId], map: "JournalEventAngleOutcomeRepairResolution_repair_message_key")
  @@index([repairId, createdAt])
  @@index([branchSessionId, createdAt])
  @@index([resolvedMessageId])
  @@index([resolutionTraceId])
}

model JournalEventEntry {
  id                       String                       @id
  eventId                  String                       @unique
  sourceBranchSessionId    String?
  generatedByTurnId        String?                      @unique
  currentGenerationTraceId String?                      @unique
  generationId             String?                      @unique
  title                    String                       @db.VarChar(16)
  content                  String
  occurredAtText           String?                      @db.VarChar(32)
  status                   JournalEventEntryStatus      @default(draft)
  generationOrigin         AIOutputOrigin
  generationVersion        Int                          @default(1)
  sourceMessageSequence    Int
  sourceMessageIds         String[]                     @default([])
  sourceFactIds            String[]                     @default([])
  sourceAngleOutcomeIds    String[]                     @default([])
  sourceFingerprint        String                       @db.Char(64)
  sourceSnapshot           Json
  contentRevision          Int                          @default(1)
  savedRevision            Int?
  editedAt                 DateTime?
  savedAt                  DateTime?
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt
  event                    JournalEvent                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sourceBranchSession      InterviewSession?            @relation("JournalEventEntrySourceBranch", fields: [sourceBranchSessionId], references: [id], onDelete: SetNull)
  generatedByTurn          InterviewUserTurn?           @relation("JournalEventEntryGeneratedByTurn", fields: [generatedByTurnId], references: [id], onDelete: SetNull)
  currentGenerationTrace   AIGenerationTrace?           @relation("CurrentJournalEventEntryGenerationTrace", fields: [currentGenerationTraceId], references: [id], onDelete: SetNull)
  generation               JournalEventEntryGeneration? @relation("JournalEventEntryGenerationResult", fields: [generationId], references: [id], onDelete: SetNull)

  @@index([sourceBranchSessionId])
  @@index([status, updatedAt])
}

model JournalEventEntryGeneration {
  id                    String                            @id @default(cuid())
  eventId               String
  branchSessionId       String?
  userTurnId            String?                           @unique
  traceId               String?                           @unique
  clientOperationId     String
  intendedEntryId       String                            @unique
  status                JournalEventEntryGenerationStatus @default(processing)
  attemptCount          Int                               @default(1)
  baseMessageSequence   Int
  sourceMessageIds      String[]                          @default([])
  sourceFactIds         String[]                          @default([])
  sourceAngleOutcomeIds String[]                          @default([])
  sourceFingerprint     String                            @db.Char(64)
  sourceSnapshot        Json
  errorCode             String?
  startedAt             DateTime                          @default(now())
  completedAt           DateTime?
  failedAt              DateTime?
  canceledAt            DateTime?
  createdAt             DateTime                          @default(now())
  updatedAt             DateTime                          @updatedAt
  event                 JournalEvent                      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  branchSession         InterviewSession?                 @relation("JournalEventEntryGenerationBranch", fields: [branchSessionId], references: [id], onDelete: SetNull)
  userTurn              InterviewUserTurn?                @relation("JournalEventEntryGenerationUserTurn", fields: [userTurnId], references: [id], onDelete: SetNull)
  trace                 AIGenerationTrace?                @relation("JournalEventEntryGenerationTrace", fields: [traceId], references: [id], onDelete: SetNull)
  entry                 JournalEventEntry?                @relation("JournalEventEntryGenerationResult")

  @@unique([eventId, clientOperationId])
  @@index([eventId, status, createdAt])
  @@index([branchSessionId, createdAt])
}

model InterviewEvent {
  id                        String               @id @default(cuid())
  sessionId                 String
  sequence                  Int
  status                    InterviewEventStatus @default(active)
  stage                     JoyInterviewStage    @default(collect_event)
  explorationRound          Int                  @default(1)
  coveredLenses             String[]             @default([])
  roundCoveredLenses        String[]             @default([])
  roundMeaningfulReplyCount Int                  @default(0)
  totalMeaningfulReplyCount Int                  @default(0)
  startMessageSequence      Int                  @default(0)
  event                     String?
  feeling                   String?
  whyItMattered             String?
  happinessType             String?
  selfPattern               String?
  snapshotData              Json?
  progressData              Json?
  confidence                Float?
  missingSlots              String[]             @default([])
  draftSummary              String?
  startedAt                 DateTime             @default(now())
  completedAt               DateTime?
  session                   InterviewSession     @relation("SessionInterviewEvents", fields: [sessionId], references: [id], onDelete: Cascade)
  activeForSession          InterviewSession[]   @relation("ActiveInterviewEvent")

  @@unique([sessionId, sequence])
  @@index([sessionId, status])
}

model InterviewMessage {
  /// Compatibility contract: generationTraceId String?
  id                            String                                     @id @default(cuid())
  sessionId                     String
  userTurnId                    String?
  generationTraceId             String?                                    @unique
  responseGroupId               String?
  responseVersion               Int?
  regenerationIntent            InterviewRegenerationIntent?
  regeneratedFromMessageId      String?
  branchSessionId               String?
  role                          InterviewRole
  inputMode                     InputMode?
  content                       String
  sequence                      Int
  createdAt                     DateTime                                   @default(now())
  session                       InterviewSession                           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  branchSession                 InterviewSession?                          @relation("InterviewMessageBranchSession", fields: [branchSessionId], references: [id], onDelete: SetNull)
  regeneratedFromMessage        InterviewMessage?                          @relation("InterviewMessageRegeneratedFrom", fields: [regeneratedFromMessageId], references: [id], onDelete: SetNull)
  regeneratedMessages           InterviewMessage[]                         @relation("InterviewMessageRegeneratedFrom")
  forkedSessions                InterviewSession[]                         @relation("InterviewSessionForkedFromMessage")
  targetedUserTurns             InterviewUserTurn[]                        @relation("InterviewUserTurnTargetMessage")
  targetRegenerations           AIResponseRegeneration[]                   @relation("RegenerationTargetMessage")
  sourceRegenerations           AIResponseRegeneration[]                   @relation("RegenerationSourceMessage")
  generatedRegenerations        AIResponseRegeneration[]                   @relation("RegenerationGeneratedMessage")
  userTurn                      InterviewUserTurn?                         @relation(fields: [userTurnId], references: [id], onDelete: SetNull)
  generationTrace               AIGenerationTrace?                         @relation("InterviewMessageGenerationTrace", fields: [generationTraceId], references: [id], onDelete: SetNull)
  branchCheckpoint              InterviewBranchCheckpoint?
  anchoredJournalEventFacts     JournalEventFact[]                         @relation("JournalEventFactPathAnchor")
  contextFactEvidence           JournalEventFactEvidence[]                 @relation("JournalEventFactEvidenceContext")
  anchoredFactEvidence          JournalEventFactEvidence[]                 @relation("JournalEventFactEvidencePathAnchor")
  understandingClaim            JournalEventUnderstandingClaim?
  anchoredFactRevisions         JournalEventFactRevision[]                 @relation("JournalEventFactRevisionPathAnchor")
  contextFactRevisions          JournalEventFactRevision[]                 @relation("JournalEventFactRevisionContext")
  angleOutcomes                 JournalEventAngleOutcome[]                 @relation("JournalEventAngleOutcomeAssistantMessage")
  anchoredAngleRepairs          JournalEventAngleOutcomeRepair[]           @relation("JournalEventAngleOutcomeRepairPathAnchor")
  angleOutcomeRepairResolutions JournalEventAngleOutcomeRepairResolution[] @relation("JournalEventAngleOutcomeRepairResolutionMessage")

  @@unique([sessionId, sequence])
  @@unique([responseGroupId, responseVersion])
  @@index([sessionId, createdAt])
  @@index([userTurnId, sequence])
  @@index([regeneratedFromMessageId])
  @@index([branchSessionId, sequence])
}

model InterviewUserTurn {
