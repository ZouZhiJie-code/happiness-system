  sessionId                    String
  journalEventId               String?
  activeEventId                String?
  action                       InterviewUserTurnAction
  targetMessageId              String?
  regenerationIntent           InterviewRegenerationIntent?
  baseBranchSessionId          String?
  rawText                      String?
