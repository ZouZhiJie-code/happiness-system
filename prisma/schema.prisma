model AIResponseRegeneration {
  id                 String                       @id @default(cuid())
  rootSessionId      String
  branchSessionId    String
  targetMessageId    String
  sourceMessageId    String
  sourceTraceId      String?
  generatedMessageId String?                      @unique
  generatedTraceId   String?
  userTurnId         String?                      @unique
  intent             InterviewRegenerationIntent
  candidates         Json?
  selectedCandidate  Int?
  checks             Json?
  status             AIResponseRegenerationStatus @default(processing)
  latencyMs          Int?
  errorCode          String?
  answeredAt         DateTime?
  replacedAt         DateTime?
  switchedBackAt     DateTime?
  downvotedAt        DateTime?
  abandonedAt        DateTime?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  completedAt        DateTime?
  session            InterviewSession             @relation("RegenerationBranchSession", fields: [branchSessionId], references: [id], onDelete: Cascade)
  rootSession        InterviewSession             @relation("RegenerationRootSession", fields: [rootSessionId], references: [id], onDelete: Cascade)
  targetMessage      InterviewMessage             @relation("RegenerationTargetMessage", fields: [targetMessageId], references: [id], onDelete: Cascade)
  sourceMessage      InterviewMessage             @relation("RegenerationSourceMessage", fields: [sourceMessageId], references: [id], onDelete: Cascade)
  generatedMessage   InterviewMessage?            @relation("RegenerationGeneratedMessage", fields: [generatedMessageId], references: [id], onDelete: SetNull)
  sourceTrace        AIGenerationTrace?           @relation("RegenerationSourceTrace", fields: [sourceTraceId], references: [id], onDelete: SetNull)
  generatedTrace     AIGenerationTrace?           @relation("RegenerationGeneratedTrace", fields: [generatedTraceId], references: [id], onDelete: SetNull)
  userTurn           InterviewUserTurn?           @relation(fields: [userTurnId], references: [id], onDelete: SetNull)

  @@index([rootSessionId, createdAt])
  @@index([targetMessageId, createdAt])
  @@index([status, createdAt])
  @@index([intent, createdAt])
}

